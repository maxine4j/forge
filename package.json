{
	"name": "@forge/app",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "pnpm build && node --watch src/main.ts",
		"start": "node dist/main.js",
		"build": "pnpm -r build && tsc -p tsconfig.build.json",
		"typecheck": "pnpm --filter @forge/backend-infrastructure --filter @forge/contracts build && pnpm -r typecheck && tsc --noEmit",
		"test": "pnpm --filter @forge/backend-infrastructure --filter @forge/contracts build && pnpm -r test && vitest run",
		"test:integration": "pnpm --filter @forge/backend-infrastructure --filter @forge/contracts build && vitest run --config tests/vitest.integration.config.ts",
		"dev:mock": "pnpm --filter @forge/contracts build && pnpm --filter @forge/frontend dev --mode mock",
		"test:browser": "pnpm --filter @forge/backend-infrastructure --filter @forge/contracts build && pnpm --filter @forge/frontend test:browser",
		"test:image": "pnpm --filter @forge/backend-infrastructure build && node tests/image-smoke.mjs",
		"image": "docker build -t forge:dev .",
		"lint": "pnpm --filter @forge/backend-infrastructure --filter @forge/contracts build && oxlint --deny-warnings .",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"check": "pnpm format:check && pnpm lint && pnpm typecheck"
	},
	"dependencies": {
		"@forge/backend-infrastructure": "workspace:*",
		"@forge/contracts": "workspace:*",
		"@koa/bodyparser": "6.1.0",
		"@koa/router": "15.7.0",
		"@openai/codex": "0.164.0",
		"koa": "3.2.1",
		"node-pty": "1.1.0",
		"pino": "10.4.0",
		"ws": "8.22.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@types/koa": "3.0.3",
		"@types/node": "24.19.2",
		"@types/ws": "8.18.2",
		"oxfmt": "0.73.0",
		"oxlint": "1.88.0",
		"typescript": "7.0.2",
		"vitest": "3.2.4"
	},
	"engines": {
		"node": ">=24 <25"
	},
	"packageManager": "pnpm@10.34.7"
}
