{
	"name": "@forge/workspace",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "pnpm --filter @forge/forge... --filter @forge/forge-web... build && pnpm --filter @forge/forge dev",
		"start": "pnpm --filter @forge/forge start",
		"build": "pnpm -r build",
		"typecheck": "pnpm --filter @forge/backend-infrastructure --filter @forge/contracts build && pnpm -r typecheck",
		"test": "pnpm --filter @forge/backend-infrastructure --filter @forge/contracts build && pnpm -r test",
		"test:integration": "pnpm --filter @forge/backend-infrastructure --filter @forge/contracts build && pnpm --filter @forge/forge test:integration",
		"dev:mock": "pnpm --filter @forge/contracts build && pnpm --filter @forge/forge-web dev --mode mock",
		"test:browser": "pnpm --filter @forge/backend-infrastructure --filter @forge/contracts build && pnpm --filter @forge/forge-web test:browser",
		"test:image": "pnpm --filter @forge/backend-infrastructure build && pnpm --filter @forge/forge test:image",
		"test:relay-image": "pnpm --filter @maxine4j/forge-ollama-client... build && pnpm --filter @forge/ollama-relay test:image",
		"image": "docker build -f services/forge/Dockerfile -t forge:dev .",
		"lint": "pnpm --filter @forge/backend-infrastructure --filter @forge/contracts build && oxlint --deny-warnings .",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"check": "pnpm format:check && pnpm lint && pnpm typecheck"
	},
	"devDependencies": {
		"@types/koa": "3.0.3",
		"@types/node": "24.19.2",
		"@types/ws": "8.18.2",
		"oxfmt": "0.73.0",
		"oxlint": "1.88.0",
		"typescript": "7.0.2",
		"vitest": "3.2.4"
	},
	"engines": {
		"node": ">=24 <25"
	},
	"packageManager": "pnpm@10.34.7"
}
